# Server-only secrets — configure these in Vercel Project Settings, not in EXPO_PUBLIC variables.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=

# Optional server configuration.
BSC_RPC_URL=https://bsc-dataseed.binance.org
PUBLIC_APP_ORIGIN=https://your-project.vercel.app

# Public Expo build-time values (never put secrets in EXPO_PUBLIC_*).
EXPO_PUBLIC_API_BASE_URL=https://your-project.vercel.app
EXPO_PUBLIC_REOWN_PROJECT_ID=
EXPO_PUBLIC_APP_URL=https://your-project.vercel.app
